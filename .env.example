# Jellyfin server URL (no trailing slash)
VITE_JELLYFIN_URL=http://localhost:8096

# App name sent in Jellyfin auth headers
VITE_JELLYFIN_APP_NAME=JellyStream

# Version sent in Jellyfin auth headers
VITE_JELLYFIN_APP_VERSION=1.0.0

# Set to true to proxy Jellyfin calls through /jellyfin instead of calling
# VITE_JELLYFIN_URL directly from the browser. Avoids CORS entirely.
# - Locally: handled by the Vite dev server proxy (vite.config.ts).
# - On Netlify: handled by a generated _redirects rule (scripts/gen-redirects.mjs),
#   which proxies /jellyfin/* -> VITE_JELLYFIN_URL server-side. No CORS config
#   needed on the Jellyfin server in this mode.
VITE_USE_PROXY=false
