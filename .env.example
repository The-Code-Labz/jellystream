# Jellyfin server URL (no trailing slash)
VITE_JELLYFIN_URL=http://localhost:8096

# App name sent in Jellyfin auth headers
VITE_JELLYFIN_APP_NAME=JellyStream

# Version sent in Jellyfin auth headers
VITE_JELLYFIN_APP_VERSION=1.0.0

# Set to true to use the Vite dev proxy at /jellyfin (avoids CORS during development)
VITE_USE_PROXY=false
